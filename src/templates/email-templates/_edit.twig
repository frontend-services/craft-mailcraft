{% requirePermission 'mailcraft:manageEmailTemplates' %}
{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("frontendservices\\mailcraft\\assetbundles\\mailcraft\\MailCraftAsset") %}
{% do view.registerTranslations('mailcraft', [
    'Preview',
    'Preview: {subject}',
    'Email preview',
    'Close',
    'Could not generate preview.',
    'Copied {variable} to the clipboard.',
    'Could not copy. Select the variable and copy it manually.',
    'Variables for “{event}”',
    'Variables',
    'Choose an event to see its variables.',
    'Replace the current title, subject and email body with the example for this event?',
    'Example loaded. Review the content and save when you are happy with it.',
    'Test sent via {channels}.',
    'None',
    'The test email could not be sent.',
    'Instantly',
    'No event chosen',
    'Any',
    'System default',
    '{amount} {unit}',
    'second', 'seconds', 'minute', 'minutes', 'hour', 'hours', 'day', 'days', 'week', 'weeks',
    'The user', 'The customer', 'The entry author', 'Me ({email})', 'System address ({email})',
]) %}

{% set pluginSettings = craft.app.plugins.getPlugin('mailcraft').getSettings() %}
{% set isNew = not emailTemplate.id %}
{% set title = emailTemplate.title ?: "New Email Template"|t('mailcraft') %}
{% set selectedSubnavItem = 'mailcraft' %}
{% set fullPageForm = true %}
{% set mailDefaults = craft.mailCraft.getSystemMailDefaults() %}
{% set eventLabels = craft.mailCraft.getEventLabels() %}

{# Delay is stored in seconds. Show it as the largest unit that divides it evenly. #}
{% set delaySeconds = emailTemplate.delay ?: 0 %}
{% set delayUnit = null %}
{% for unit in [604800, 86400, 3600, 60] %}
    {% if delayUnit is null and delaySeconds > 0 and delaySeconds % unit == 0 %}
        {% set delayUnit = unit %}
    {% endif %}
{% endfor %}
{% if delayUnit is null %}{% set delayUnit = delaySeconds > 0 ? 1 : 60 %}{% endif %}
{% set delayAmount = delaySeconds > 0 ? (delaySeconds / delayUnit)|round : 0 %}

{% set contentHasErrors = emailTemplate.hasErrors('title') or emailTemplate.hasErrors('subject') or emailTemplate.hasErrors('template') %}
{% set triggerHasErrors = emailTemplate.hasErrors('event') or emailTemplate.hasErrors('delay') or emailTemplate.hasErrors('conditions') or emailTemplate.hasErrors('condition1') or emailTemplate.hasErrors('condition2') %}
{% set recipientsHaveErrors = emailTemplate.hasErrors('to') or emailTemplate.hasErrors('toName') or emailTemplate.hasErrors('from') or emailTemplate.hasErrors('fromName') or emailTemplate.hasErrors('cc') or emailTemplate.hasErrors('bcc') or emailTemplate.hasErrors('replyTo') %}

{% set tabs = {
    'tab-content': { label: 'Content'|t('mailcraft'), url: '#tab-content', class: contentHasErrors ? 'error' : '' },
    'tab-trigger': { label: 'Trigger'|t('mailcraft'), url: '#tab-trigger', class: triggerHasErrors ? 'error' : '' },
} %}

{% set enabledChannels = emailTemplate.getEnabledChannels() %}
{% for handle, channel in channels %}
    {% set channelErrorKeys = emailTemplate.getErrors()|keys|filter(k => k starts with "channels.#{handle}.") %}
    {% set channelHasErrors = channelErrorKeys|length > 0 or (handle == 'email' and recipientsHaveErrors) %}
    {% set tabClasses = [channelHasErrors ? 'error' : null, emailTemplate.isChannelEnabled(handle) ? 'mailcraft-channel-on' : null]|filter(c => c) %}
    {% set tabs = tabs|merge({ ("tab-channel-#{handle}"): { label: channel.getName(), url: "#tab-channel-#{handle}", class: tabClasses|join(' ') } }) %}
{% endfor %}
{% set testChannels = enabledChannels|filter(c => c.supportsTestSend())|map(c => c.getName()) %}
{% set anyTestChannel = channels|filter(c => c.supportsTestSend())|length > 0 %}

{% set formActions = [
    {
        label: 'Save and continue editing'|t('mailcraft'),
        action: 'mailcraft/email-templates/save',
        redirect: 'mailcraft/email-templates/{id}'|hash,
        retainScroll: true,
        shortcut: true,
    },
    {
        label: 'Save and add another'|t('mailcraft'),
        redirect: 'mailcraft/email-templates/new'|hash,
        shortcut: true,
        shift: true,
    },
    {
        label: 'Delete'|t('mailcraft'),
        confirm: 'Are you sure you want to delete this email?'|t('mailcraft'),
        action: 'mailcraft/email-templates/delete',
        redirect: 'mailcraft'|hash,
        destructive: true,
    }
] %}

{% set crumbs = [
    { label: "Email Templates"|t('mailcraft'), url: 'mailcraft' },
] %}

{% set additionalButtons %}
    <button type="button" id="mailcraft-preview-btn" class="btn">{{ 'Preview'|t('mailcraft') }}</button>
{% endset %}

{% block content %}
    {{ actionInput('mailcraft/email-templates/save') }}
    {{ redirectInput('mailcraft') }}
    {% if emailTemplate.id %}{{ hiddenInput('templateId', emailTemplate.id) }}{% endif %}

    {# --- Content --- #}
    <div id="tab-content" class="flex-fields">
        {{ forms.textField({
            first: true,
            label: "Title"|t('mailcraft'),
            instructions: "Internal name. Only shown in the control panel."|t('mailcraft'),
            id: 'title',
            name: 'title',
            value: emailTemplate.title,
            errors: emailTemplate.getErrors('title'),
            autofocus: true,
            required: true,
        }) }}

        {{ forms.textField({
            label: "Subject"|t('mailcraft'),
            instructions: "The subject line. Variables work here too."|t('mailcraft'),
            id: 'subject',
            name: 'subject',
            value: emailTemplate.subject,
            errors: emailTemplate.getErrors('subject'),
            required: true,
        }) }}

        <div class="mailcraft-editor-grid">
            {{ craft.mailCraft.templateEditor(emailTemplate)|raw }}
            <aside class="mailcraft-vars" id="mailcraft-vars" aria-live="polite">
                <h3 class="mailcraft-vars__title" id="mailcraft-vars-title">{{ 'Variables'|t('mailcraft') }}</h3>
                <p class="light mailcraft-vars__hint">{{ 'Click a variable to copy it, then paste it into the subject or the email body.'|t('mailcraft') }}</p>
                <ul class="mailcraft-vars__list" id="mailcraft-vars-list"></ul>
            </aside>
        </div>
    </div>

    {# --- Trigger --- #}
    <div id="tab-trigger" class="flex-fields hidden">
        {% set eventInput %}
            <div class="flex flex-nowrap mailcraft-event-row">
                {{ forms.selectize({
                    id: 'event',
                    name: 'event',
                    value: emailTemplate.event,
                    options: craft.mailCraft.getAvailableEventsForOptions(),
                }) }}
                <button type="button" id="mailcraft-load-example" class="btn small" disabled>{{ 'Load example email for this event'|t('mailcraft') }}</button>
            </div>
        {% endset %}
        {{ forms.field({
            label: "Event"|t('mailcraft'),
            instructions: "What has to happen for this email to be sent."|t('mailcraft'),
            id: 'event',
            errors: emailTemplate.getErrors('event'),
            required: true,
        }, eventInput) }}

        {{ forms.selectizeField({
            label: "Condition 1"|t('mailcraft'),
            id: 'condition1',
            name: 'condition1',
            value: emailTemplate.condition1,
            options: [],
            errors: emailTemplate.getErrors('condition1'),
            fieldClass: 'hidden',
        }) }}

        {{ forms.selectizeField({
            label: "Condition 2"|t('mailcraft'),
            id: 'condition2',
            name: 'condition2',
            value: emailTemplate.condition2,
            options: [],
            errors: emailTemplate.getErrors('condition2'),
            fieldClass: 'hidden',
        }) }}

        {% set delayInput %}
            {{ hiddenInput('delay', delaySeconds, { id: 'delay' }) }}
            <div class="flex flex-nowrap mailcraft-delay">
                {{ forms.text({
                    id: 'delay-amount',
                    type: 'number',
                    min: 0,
                    step: 1,
                    size: 5,
                    value: delayAmount,
                    class: 'mailcraft-delay__amount',
                }) }}
                {{ forms.select({
                    id: 'delay-unit',
                    value: delayUnit,
                    options: [
                        { value: 60, label: 'minutes'|t('mailcraft') },
                        { value: 3600, label: 'hours'|t('mailcraft') },
                        { value: 86400, label: 'days'|t('mailcraft') },
                        { value: 604800, label: 'weeks'|t('mailcraft') },
                        { value: 1, label: 'seconds'|t('mailcraft') },
                    ],
                }) }}
                <span class="light">{{ 'after the event'|t('mailcraft') }}</span>
            </div>
            <div class="flex mailcraft-delay__presets">
                <button type="button" class="btn small" data-delay="0">{{ 'Instantly'|t('mailcraft') }}</button>
                <button type="button" class="btn small" data-delay="3600">{{ '1 hour'|t('mailcraft') }}</button>
                <button type="button" class="btn small" data-delay="86400">{{ '1 day'|t('mailcraft') }}</button>
                <button type="button" class="btn small" data-delay="604800">{{ '1 week'|t('mailcraft') }}</button>
                <button type="button" class="btn small" data-delay="2592000">{{ '30 days'|t('mailcraft') }}</button>
            </div>
        {% endset %}
        {{ forms.field({
            label: "Send"|t('mailcraft'),
            instructions: "How long after the event the email goes out. For example, a reminder 2 days after someone registers."|t('mailcraft'),
            id: 'delay-amount',
            errors: emailTemplate.getErrors('delay'),
        }, delayInput) }}

        <div class="field">
            <a class="fieldtoggle{{ emailTemplate.conditions ? ' expanded' }}" data-target="mailcraft-advanced-condition" role="button" tabindex="0" aria-expanded="{{ emailTemplate.conditions ? 'true' : 'false' }}">{{ 'Advanced: Twig condition'|t('mailcraft') }}</a>
            <div id="mailcraft-advanced-condition" class="mailcraft-disclosure{{ not emailTemplate.conditions ? ' hidden' }}">
                {{ forms.textareaField({
                    label: "Only send when this is true"|t('mailcraft'),
                    instructions: "A Twig expression using the event's variables. Example: `entry.section.handle == \"news\"` or `user.email ends with \"@company.com\"`."|t('mailcraft'),
                    id: 'conditions',
                    name: 'conditions',
                    class: 'code',
                    rows: 2,
                    value: emailTemplate.conditions,
                    errors: emailTemplate.getErrors('conditions'),
                }) }}
            </div>
        </div>
    </div>

    {# --- One tab per channel --- #}
    {% for handle, channel in channels %}
        <div id="tab-channel-{{ handle }}" class="flex-fields hidden mailcraft-channel{{ not emailTemplate.isChannelEnabled(handle) ? ' mailcraft-channel--off' }}" data-channel="{{ handle }}" data-channel-name="{{ channel.getName() }}">
            {{ forms.lightswitchField({
                label: "Send via {channel}"|t('mailcraft', { channel: channel.getName() }),
                id: "channels-#{handle}-enabled",
                name: "channels[#{handle}][enabled]",
                on: emailTemplate.isChannelEnabled(handle),
                fieldClass: 'mailcraft-channel-switch',
            }) }}
            {# Channel fields are direct children of the tab: nesting another .flex-fields makes Craft draw them as nested fields. #}
            {{ channel.getTemplateSettingsHtml(emailTemplate)|raw }}
        </div>
    {% endfor %}
{% endblock %}

{% block details %}
    <div class="meta">
        {{ forms.lightswitchField({
            label: "Enabled"|t('app'),
            id: 'enabled',
            name: 'enabled',
            on: emailTemplate.enabled,
        }) }}
    </div>

    <div class="meta read-only mailcraft-summary">
        <div class="data">
            <h5 class="heading">{{ 'Sends when'|t('mailcraft') }}</h5>
            <div class="value" id="mailcraft-summary-event">{{ emailTemplate.event ? (eventLabels[emailTemplate.event] ?? emailTemplate.event) : 'No event chosen'|t('mailcraft') }}</div>
        </div>
        <div class="data hidden" id="mailcraft-summary-condition-row">
            <h5 class="heading">{{ 'Only if'|t('mailcraft') }}</h5>
            <div class="value" id="mailcraft-summary-condition"></div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Delay'|t('mailcraft') }}</h5>
            <div class="value" id="mailcraft-summary-delay"></div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Channels'|t('mailcraft') }}</h5>
            <div class="value" id="mailcraft-summary-channels">{{ enabledChannels|map(c => c.getName())|join(', ') ?: 'None'|t('mailcraft') }}</div>
        </div>
        {% for handle, channel in channels %}
            {% if handle == 'email' %}
                <div class="data{{ not emailTemplate.isChannelEnabled('email') ? ' hidden' }}" data-channel-summary="email">
                    <h5 class="heading">{{ 'To'|t('mailcraft') }}</h5>
                    <div class="value"><code id="mailcraft-summary-to">{{ emailTemplate.to }}</code></div>
                </div>
                <div class="data{{ not emailTemplate.isChannelEnabled('email') ? ' hidden' }}" data-channel-summary="email">
                    <h5 class="heading">{{ 'From'|t('mailcraft') }}</h5>
                    <div class="value" id="mailcraft-summary-from">{{ emailTemplate.from ?: 'System default'|t('mailcraft') }}</div>
                </div>
            {% else %}
                {% for label, value in channel.getTemplateSummary(emailTemplate) %}
                    <div class="data{{ not emailTemplate.isChannelEnabled(handle) ? ' hidden' }}" data-channel-summary="{{ handle }}">
                        <h5 class="heading">{{ label }}</h5>
                        <div class="value">{{ value }}</div>
                    </div>
                {% endfor %}
            {% endif %}
        {% endfor %}
    </div>
    <p class="warning with-icon mailcraft-no-channel-warning{{ enabledChannels|length ? ' hidden' }}" id="mailcraft-no-channel-warning">{{ 'Nothing will be sent: no channel is enabled.'|t('mailcraft') }}</p>

    {% if anyTestChannel %}
    <div class="meta">
        <div class="field" id="mailcraft-send-test-field">
            <div class="heading"><label for="mailcraft-send-test">{{ 'Test'|t('mailcraft') }}</label></div>
            <div class="input ltr">
                <button type="button" id="mailcraft-send-test" class="btn small">{{ 'Send a test to me'|t('mailcraft') }}</button>
                <div class="smalltext light mailcraft-send-test__hint">{{ 'Uses sample data and goes to {email} by email.'|t('mailcraft', { email: currentUser.email }) }}</div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if emailTemplate.id %}
        <div class="meta read-only">
            <div class="data">
                <h5 class="heading">{{ "Created at"|t('app') }}</h5>
                <div class="value">{{ emailTemplate.dateCreated|datetime('short') }}</div>
            </div>
            <div class="data">
                <h5 class="heading">{{ "Updated at"|t('app') }}</h5>
                <div class="value">{{ emailTemplate.dateUpdated|datetime('short') }}</div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% js %}
    new Craft.MailCraftEditor({{ {
        templateId: emailTemplate.id,
        event: emailTemplate.event,
        condition1: emailTemplate.condition1,
        condition2: emailTemplate.condition2,
        eventLabels: eventLabels,
        variables: craft.mailCraft.getEventTemplateVariables(),
        examples: craft.mailCraft.getTemplateExamples(),
        conditions: craft.mailCraft.getGlobalConditions,
        currentUserEmail: currentUser.email,
        systemFromEmail: mailDefaults.fromEmail,
        systemFromName: mailDefaults.fromName,
    }|json_encode|raw }});
{% endjs %}
